# ==============================
# WayForPay
# ==============================
WFP_MERCHANT_ACCOUNT=
# домен, зареєстрований у WFP (без протоколу, напр. rae-shop.netlify.app)
WFP_MERCHANT_DOMAIN=
# URL, на який WFP шле серверний callback про оплату.
# Локально — публічний тунель netlify dev --live:
#   https://<random>--rae-shop.netlify.live/.netlify/functions/wfp-callback
# Прод — https://rae-shop.netlify.app/.netlify/functions/wfp-callback
WFP_SERVICE_URL=
# Сторінка "дякуємо" на Webflow-сайті Rae, куди WFP поверне покупця після оплати
WFP_RETURN_URL=
# live-ключ (використовується коли WFP_TEST_MODE не "true")
WFP_SECRET_KEY=
# тестовий ключ пісочниці (використовується коли WFP_TEST_MODE=true)
WFP_TEST_SECRET_KEY=
# "true" перемикає checkout.js І wfp-callback.js на тестовий секрет одночасно
WFP_TEST_MODE=false

# ==============================
# Brevo — Transactional Email API (order confirmation)
# ==============================
BREVO_API_KEY=
# числовий ID шаблону "Order confirmation" у Brevo (Campaigns > Templates)
BREVO_ORDER_CONFIRMATION_TEMPLATE_ID=
# відправник має бути верифікований у Brevo, інакше API поверне помилку
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ==============================
# Інше
# ==============================
# CORS: origin, з якого дозволено fetch() до checkout (браузер Webflow-сайту).
# Порожньо = "*" (зручно локально; перед продом виставити реальний Webflow-домен Rae)
CORS_ALLOWED_ORIGIN=

# Опційний форвард нормалізованого WFP-callback payload у зовнішню автоматизацію
# (напр. Make.com). Порожньо = форвард вимкнено.
MAKE_WEBHOOK_URL=

# Дебаг-лог у wfp-callback.js (тіло колбеку, content-type). "1" = увімкнути.
DEBUG_WFP_CALLBACK=

# ------------------------------
# CHECKOUT_ENDPOINT тут НЕ потрібен (на відміну від Punkt): у Rae немає збірки,
# тож підставити значення в бандл нікому. URL бекенду — константа в public/app.js
# (з локальним перевизначенням через window.RAE_CHECKOUT_ENDPOINT у харнесі).
# ------------------------------
